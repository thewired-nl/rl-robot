<mujoco model="balance robot">
  <compiler
		angle="degree"
		coordinate="local"
		autolimits="true"
	/>

	<visual>
		<map znear="0.001" zfar="10"/>
		<scale contactwidth="0.1" contactheight="0.03"/>
	</visual>

	<option
		timestep="0.005"
		gravity="0 0 -9.81"
		integrator="implicitfast"
	/>

  <default>
		<geom
			contype="1"
			conaffinity="1"
      friction="0.8 0.005 0.005"
		/>
  </default>

  <asset>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4" markrgb="0.2 0.3 0.4" width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="2 2" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="ground" size="200 200 0.1" type="plane" material="grid"/>
    <!-- <light pos="0 0 10" dir="0 0 -1" mode="trackcom"/> -->
    <light pos="0 0 100" dir="0 0 -1" mode="fixed" ambient="0.4 0.4 0.4"/>
  </worldbody>

</mujoco>
